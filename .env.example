# ===== 生成模型（通义千问 / DashScope） =====
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
MODEL=qwen-plus

# ===== 向量化端点（RAG 检索用） =====
# 默认阿里云 DashScope（与生成共用 Key）
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBED_MODEL=text-embedding-v2
# 本地用 LM Studio 时改为（构建与运行时必须同源同模型）：
# EMBED_BASE_URL=http://localhost:1234/v1
# EMBED_MODEL=nomic-embed-text
# EMBED_API_KEY 留空则复用 DASHSCOPE_API_KEY（LM Studio 本地一般无需 Key）
# EMBED_API_KEY=

# ===== 阿里云 Tair（Redis 兼容） =====
# 留空则内存降级（仅本地 / 单实例有效，多实例部署务必配置）
TAIR_URL=redis://:password@host:6379

# ===== 支付（占位，真实渠道接入后填写） =====
# 微信 / 支付宝 / Stripe 三选一，接入前以下留空
# PAY_CHANNEL=alipay
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# 支付宝回调地址需配置为：https://你的域名/api/webhooks/alipay
